<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/card_view"
    android:layout_margin="8dp"
    android:background="@color/cardview_light_background"
    android:elevation="12dp"
    app:cardCornerRadius="30dp"
    app:cardElevation="10dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="5dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:id="@+id/guide_image"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="8dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="test coldStorage"
                android:textSize="22sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/title_background"
                android:fontFamily="@font/kohinoor_bangla_bold"
                android:textColor="#ffffff"
                android:gravity="center_horizontal" />

            <TextView
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Abdul Makel"
                android:layout_marginTop="10dp"
                android:textSize="12sp"
                android:padding="8dp"
                android:background="@drawable/cold_text_background"
                android:fontFamily="@font/kohinoor_bangla_bold"
                android:textColor="#004E89"
                android:gravity="center_horizontal" />

            <!-- RecyclerView for Cold Storage Types -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/crop_life_cycle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#ffffff"
                android:scrollbars="vertical" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
